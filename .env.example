# --- required
ANTHROPIC_API_KEY=
# --- service
ALLOWED_ORIGINS=http://localhost:5173
ENRICH_ENABLED=false
MAX_CONCURRENT_DRAFTS=4
DAILY_SPEND_CAP_USD=20
LOG_LEVEL=INFO
# REDIS_URL is set by docker-compose; for a bare run: redis://127.0.0.1:6379/0 (unset = in-memory jobs)
# --- benchmark only (not needed by the service)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# --- Contabo API (deployment provisioning only)
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
